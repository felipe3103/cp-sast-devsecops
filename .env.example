# Copie para .env e ajuste. NUNCA versione o .env.
POSTGRES_PASSWORD=troque-esta-senha
SAST_API_TOKEN=gere-um-token-com-openssl-rand-hex-32
OLLAMA_MODEL=llama3
# Ollama rodando no próprio computador (fora do Docker), ex.: Mac com GPU Metal:
# OLLAMA_URL=http://host.docker.internal:11434
AI_AUTO_TRIAGE=false
AI_AUTO_LIMIT=15
ALLOWED_GIT_HOSTS=github.com,gitlab.com
MAX_UPLOAD_MB=50
# Backend da IA: langchain (padrão: ChatPromptTemplate -> ChatOllama + RAG) ou http (API direta)
AI_BACKEND=langchain
# RAG: embeddings baixados do Hugging Face Hub e servidos pelo Ollama (0 desliga o RAG)
AI_RAG=1
EMBED_MODEL=hf.co/nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0
